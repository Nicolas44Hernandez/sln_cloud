{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Create DB (DEVELOPMENT)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/db_manage.py",
            "console": "integratedTerminal",
            "env": {
                "FLASK_ENV": "DEVELOPMENT",
                "DB_ENV": "DEVELOPMENT",
            },
            "args": [
                "create"
            ]
        },        
        {
            "name": "Create DB (PRODUCTION)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/db_manage.py",
            "console": "integratedTerminal",
            "env": {
                "FLASK_ENV": "DEVELOPMENT",
                "DB_ENV": "PRODUCTION",
            },
            "args": [
                "create"
            ]
        },
        {
            "name": "Delete DB",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/db_manage.py",
            "console": "integratedTerminal",
            "env": {
                "FLASK_ENV": "DEVELOPMENT",
                "DB_ENV": "DEVELOPMENT",
            },
            "args": [
                "delete"
            ]
        },
        {
            "name": "Export DB",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/db_backup.py",
            "console": "integratedTerminal",
            "env": {
                "FLASK_ENV": "DEVELOPMENT",
            },
            "args": [
                "export",
                "database_import_folder",
            ]
        },
        {
            "name": "Import DB",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/db_backup.py",
            "console": "integratedTerminal",
            "env": {
                "FLASK_ENV": "DEVELOPMENT",
            },
            "args": [
                "import",
                "database_import_folder",
            ]
        },
        {
            "name": "Run backend in dev",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "backend/server/app:create_app()",
                "FLASK_ENV": "DEVELOPMENT",
            },
            "args": [
                "run",
                "--host",
                "0.0.0.0",
                "--port",
                "3000",
                "--no-reload",
            ]
        }
    ]
}